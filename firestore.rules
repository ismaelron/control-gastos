rules_version = '2';

// Reglas de seguridad de Control de Gastos.
// - Cada usuario tiene sus preferencias en users/{uid}.
// - Los datos viven en "libros" (books). Solo los miembros de un libro pueden
//   verlo y modificarlo. Para unirse a un libro hace falta una invitación vigente.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function bookData(bookId) {
      return get(/databases/$(database)/documents/books/$(bookId)).data;
    }

    function isMember(bookId) {
      return signedIn() && uid() in bookData(bookId).members;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validBookFields(d) {
      return d.keys().hasOnly(['name', 'owner', 'members', 'memberInfo', 'budget',
                               'categoryBudgets', 'categories', 'accounts', 'createdAt', 'joinCode'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.owner is string
        && d.members is list && d.members.size() <= 20
        && d.memberInfo is map
        && (!('budget' in d) || (d.budget is int && d.budget >= 0))
        && (!('categoryBudgets' in d) || d.categoryBudgets is map)
        && (!('categories' in d) || (d.categories is list && d.categories.size() <= 60))
        && (!('accounts' in d) || (d.accounts is list && d.accounts.size() <= 30));
    }

    // Preferencias del usuario (libro activo) y datos de la versión anterior.
    match /users/{userId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['activeBook', 'budget', 'categoryBudgets']);

      match /movements/{movementId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    match /books/{bookId} {
      // resource == null: permite comprobar si el libro personal ya existe.
      allow read: if signedIn() && (resource == null || uid() in resource.data.members);

      allow create: if signedIn()
        && request.resource.data.owner == uid()
        && request.resource.data.members == [uid()]
        && validBookFields(request.resource.data);

      allow update: if signedIn() && validBookFields(request.resource.data)
        && request.resource.data.owner == resource.data.owner
        && (
          // El dueño puede cambiar todo (incluido quitar miembros), sin quitarse a sí mismo.
          (uid() == resource.data.owner && uid() in request.resource.data.members)
          // Un miembro puede cambiar los ajustes, pero no la lista de miembros...
          || (uid() in resource.data.members
              && !changed().hasAny(['members', 'owner', 'joinCode']))
          // ...o salir del libro.
          || (uid() in resource.data.members && uid() != resource.data.owner
              && changed().hasOnly(['members', 'memberInfo'])
              && request.resource.data.members.toSet() == resource.data.members.toSet().difference([uid()].toSet())
              && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([uid()]))
          // Unirse con una invitación vigente de este libro.
          || (!(uid() in resource.data.members)
              && changed().hasOnly(['members', 'memberInfo', 'joinCode'])
              && request.resource.data.members.toSet() == resource.data.members.toSet().union([uid()].toSet())
              && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([uid()])
              && exists(/databases/$(database)/documents/invites/$(request.resource.data.joinCode))
              && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.bookId == bookId
              && get(/databases/$(database)/documents/invites/$(request.resource.data.joinCode)).data.expiresAt > request.time)
        );

      allow delete: if signedIn() && uid() == resource.data.owner;

      match /movements/{movementId} {
        allow read, delete: if isMember(bookId);
        allow create, update: if isMember(bookId) && validMovement(request.resource.data);
      }

      match /recurring/{recurringId} {
        allow read, delete: if isMember(bookId);
        allow create, update: if isMember(bookId) && validRecurring(request.resource.data);
      }

      match /goals/{goalId} {
        allow read, delete: if isMember(bookId);
        allow create, update: if isMember(bookId) && validGoal(request.resource.data);
      }
    }

    // Invitaciones: cualquiera con sesión y el código puede leerla (no listarlas).
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && request.resource.data.keys().hasOnly(['bookId', 'bookName', 'createdBy', 'createdByName', 'createdAt', 'expiresAt'])
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd')
        && isMember(request.resource.data.bookId);
      allow delete: if signedIn() && resource.data.createdBy == uid();
    }

    function validMovement(d) {
      return d.keys().hasOnly(['type', 'date', 'amount', 'category', 'account', 'toAccount',
                               'note', 'createdAt', 'createdBy', 'recurringId'])
        && d.type in ['gasto', 'ingreso', 'transferencia']
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.amount is int && d.amount > 0 && d.amount < 100000000000000
        && (d.type == 'transferencia' || (d.category is string && d.category.size() <= 40))
        && (!('account' in d) || (d.account is string && d.account.size() <= 40))
        && (!('toAccount' in d) || (d.toAccount is string && d.toAccount.size() <= 40))
        && d.note is string && d.note.size() <= 200
        && d.createdAt is int;
    }

    function validRecurring(d) {
      return d.keys().hasOnly(['type', 'amount', 'category', 'account', 'toAccount', 'note',
                               'day', 'start', 'lastMonth', 'active', 'createdAt'])
        && d.type in ['gasto', 'ingreso', 'transferencia']
        && d.amount is int && d.amount > 0 && d.amount < 100000000000000
        && d.day is int && d.day >= 1 && d.day <= 31
        && d.start is string && d.start.matches('^[0-9]{4}-[0-9]{2}$')
        && (!('note' in d) || (d.note is string && d.note.size() <= 200));
    }

    function validGoal(d) {
      return d.keys().hasOnly(['name', 'icon', 'color', 'target', 'saved', 'deadline', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.target is int && d.target > 0
        && d.saved is int;
    }
  }
}
